--// Caos na Cozinha - Scan Frente + Panela + Pia v3
--// SCAN FRENTE: scan normal do objeto/interação na frente.
--// SCAN PANELA: scan focado em Hob/FryingPan.
--// SCAN PIA: scan focado em Sink, ProgressBar e Plate/DirtyPlate.
--// Todos copiam o resultado para a área de transferência, se o executor suportar.

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")
local cam = Workspace.CurrentCamera
local GUI_NAME = "CK_ScanFrentePanelaPiaV3"

local WORDS = {
    "foodbin","ingredient","tomato","pineapple","beef","meat","carne",
    "chopping","cut","knife","faca","hob","pan","saucepan","pot","cook",
    "countertop","plate","dirtyplate","sink","sell","sellpoint","delivery","serve"
}

local function low(x) return string.lower(tostring(x or "")) end
local function root() return workspace:FindFirstChild("Interactables") or workspace end

local function copy(txt)
    if setclipboard then setclipboard(txt) return true end
    if toclipboard then toclipboard(txt) return true end
    if syn and syn.write_clipboard then syn.write_clipboard(txt) return true end
    return false
end

local function path(o)
    local ok, r = pcall(function() return o:GetFullName() end)
    return ok and r or tostring(o)
end

local function asset(x)
    x = tostring(x or "")
    return x:match("rbxassetid://(%d+)") or x:match("id=(%d+)") or x
end

local function hrp()
    local c = lp.Character or lp.CharacterAdded:Wait()
    return c:FindFirstChild("HumanoidRootPart")
end

local function part(o)
    if not o then return nil end
    if o:IsA("BasePart") then return o end
    if o:IsA("Model") then return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true) end
    return o:FindFirstAncestorWhichIsA("BasePart")
end

local function pos(o)
    local p = part(o)
    return p and p.Position
end

local function dist(o)
    local h, p = hrp(), pos(o)
    if not h or not p then return nil end
    return math.floor((p - h.Position).Magnitude)
end

local function posText(v)
    if not v then return "sem pos" end
    return math.floor(v.X)..","..math.floor(v.Y)..","..math.floor(v.Z)
end

local function hasWord(o)
    local t = low(o.Name.." "..path(o))
    for _, w in ipairs(WORDS) do
        if t:find(low(w), 1, true) then return true, w end
    end
    return false, nil
end

local function top(o)
    if not o then return nil end
    local r = root()
    local cur = o:IsA("Model") and o or o:FindFirstAncestorOfClass("Model") or o
    while cur and cur.Parent and cur.Parent ~= r and cur.Parent ~= workspace do
        if hasWord(cur) then break end
        cur = cur.Parent
    end
    return cur
end

local function screenScore(o)
    local p = pos(o)
    if not p or not cam then return math.huge end
    local v, on = cam:WorldToViewportPoint(p)
    if not on then return math.huge end
    return (Vector2.new(v.X, v.Y) - Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)).Magnitude
end

local function promptTarget()
    local h = hrp()
    if not h then return nil end
    local best, score = nil, math.huge
    for _, d in ipairs(root():GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local p = pos(d.Parent)
            if p then
                local dd = (p - h.Position).Magnitude
                if dd <= 18 then
                    local t = top(d.Parent) or d.Parent
                    local s = dd + screenScore(t)/120
                    if s < score then best, score = t, s end
                end
            end
        end
    end
    return best
end

local function rayTarget()
    if not cam then return nil end
    local ray = cam:ViewportPointToRay(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.IgnoreWater = true
    params.FilterDescendantsInstances = lp.Character and {lp.Character} or {}
    local r = workspace:Raycast(ray.Origin, ray.Direction * 70, params)
    if r and r.Instance then return top(r.Instance) or r.Instance, r.Instance, r.Position end
    return nil
end

local function frontImportant()
    local h = hrp()
    if not h or not cam then return nil end
    local best, score = nil, math.huge
    for _, o in ipairs(root():GetDescendants()) do
        if hasWord(o) then
            local t = top(o)
            local p = pos(t)
            if p then
                local off = p - h.Position
                if off.Magnitude <= 70 and cam.CFrame.LookVector:Dot(off.Unit) > 0.45 then
                    local s = screenScore(t) + off.Magnitude * 2
                    if s < score then best, score = t, s end
                end
            end
        end
    end
    return best
end

local function getTarget()
    local p = promptTarget()
    if p then return p, "ProximityPrompt" end
    local r, hit, hitPos = rayTarget()
    if r then return r, "Raycast", hit, hitPos end
    local f = frontImportant()
    if f then return f, "Objeto na frente" end
    return nil, "nenhum"
end

local function printCopy(title, lines)
    local txt = "[CK] ===== "..title.." =====\n"..table.concat(lines, "\n").."\n[CK] ===== FIM "..title.." ====="
    local ok = copy(txt)
    warn("[CK] ===== "..title.." =====")
    warn(ok and "[CK] COPIADO" or "[CK] NÃO COPIOU")
    local buf = {}
    for _, line in ipairs(lines) do
        table.insert(buf, line)
        if #buf >= 16 then
            print("[CK]\n"..table.concat(buf, "\n"))
            table.clear(buf)
            task.wait(0.03)
        end
    end
    if #buf > 0 then print("[CK]\n"..table.concat(buf, "\n")) end
    warn("[CK] ===== FIM "..title.." =====")
end

local function attrs(o)
    local a = {}
    for k,v in pairs(o:GetAttributes()) do table.insert(a, tostring(k).."="..tostring(v)) end
    table.sort(a)
    return a
end

local function infoDesc(o, limit)
    local out = {}
    for _, d in ipairs(o:GetDescendants()) do
        if #out >= (limit or 70) then break end
        if d:IsA("ProximityPrompt") then
            table.insert(out, "PROMPT "..d.Name.." Action="..tostring(d.ActionText).." Object="..tostring(d.ObjectText).." | "..path(d))
        elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
            table.insert(out, d.ClassName.." "..d.Name.." image="..asset(d.Image).." | "..path(d))
        elseif d:IsA("Decal") or d:IsA("Texture") then
            table.insert(out, d.ClassName.." "..d.Name.." texture="..asset(d.Texture).." | "..path(d))
        elseif d:IsA("MeshPart") then
            if tostring(d.TextureID) ~= "" then table.insert(out, "MeshPart "..d.Name.." textureID="..asset(d.TextureID).." | "..path(d)) end
        elseif d:IsA("SpecialMesh") then
            if tostring(d.TextureId) ~= "" then table.insert(out, "SpecialMesh "..d.Name.." textureId="..asset(d.TextureId).." | "..path(d)) end
        elseif d:IsA("StringValue") or d:IsA("IntValue") or d:IsA("NumberValue") or d:IsA("BoolValue") or d:IsA("ObjectValue") then
            table.insert(out, "VALUE "..d.Name.." ["..d.ClassName.."]="..tostring(d.Value).." | "..path(d))
        end
    end
    return out
end

local function scanFrente()
    local o, source, hit, hitPos = getTarget()
    local lines = {}
    if not o then
        table.insert(lines, "Nada detectado.")
        printCopy("SCAN FRENTE", lines)
        return
    end
    local _, word = hasWord(o)
    table.insert(lines, "Fonte: "..source)
    table.insert(lines, "Name: "..o.Name.." ["..o.ClassName.."]")
    table.insert(lines, "Path: "..path(o))
    table.insert(lines, "Pos: "..posText(pos(o)))
    table.insert(lines, "Dist: "..tostring(dist(o) or "?"))
    table.insert(lines, "Keyword: "..tostring(word or "nenhuma"))
    if hit then
        table.insert(lines, "HitPart: "..hit.Name.." ["..hit.ClassName.."]")
        table.insert(lines, "HitPath: "..path(hit))
        table.insert(lines, "HitPos: "..posText(hitPos))
    end
    table.insert(lines, "")
    table.insert(lines, "Attributes:")
    for _, x in ipairs(attrs(o)) do table.insert(lines, "  "..x) end
    table.insert(lines, "")
    table.insert(lines, "Children:")
    for _, c in ipairs(o:GetChildren()) do table.insert(lines, "  - "..c.Name.." ["..c.ClassName.."]") end
    table.insert(lines, "")
    table.insert(lines, "Assets/Prompts/Values:")
    for _, x in ipairs(infoDesc(o, 80)) do table.insert(lines, "  "..x) end
    printCopy("SCAN FRENTE", lines)
end

local function findByAppliance(appliance, nameHint)
    local o = getTarget()
    if o and (o:GetAttribute("ApplianceType") == appliance or low(o.Name):find(low(nameHint), 1, true)) then
        return o, "frente"
    end
    if o then
        local cur = o
        while cur and cur ~= workspace do
            if cur:IsA("Model") and (cur:GetAttribute("ApplianceType") == appliance or low(cur.Name):find(low(nameHint), 1, true)) then
                return cur, "ancestor"
            end
            cur = cur.Parent
        end
    end

    local h = hrp()
    local best, bd = nil, math.huge
    for _, x in ipairs(root():GetDescendants()) do
        if x:IsA("Model") and (x:GetAttribute("ApplianceType") == appliance or low(x.Name):find(low(nameHint), 1, true)) then
            local p = pos(x)
            if p and h then
                local d = (p - h.Position).Magnitude
                if d < bd and d <= 25 then best, bd = x, d end
            end
        end
    end
    return best, "mais próximo"
end

local function guiLine(g)
    local t = {}
    table.insert(t, g.Name.." ["..g.ClassName.."]")
    table.insert(t, "Path="..path(g))
    if g:IsA("BillboardGui") or g:IsA("SurfaceGui") or g:IsA("ScreenGui") then
        table.insert(t, "Enabled="..tostring(g.Enabled))
    end
    if g:IsA("GuiObject") then
        table.insert(t, "Visible="..tostring(g.Visible))
        table.insert(t, "Size="..tostring(g.Size))
        table.insert(t, "AbsoluteSize="..math.floor(g.AbsoluteSize.X).."x"..math.floor(g.AbsoluteSize.Y))
        table.insert(t, "Position="..tostring(g.Position))
        table.insert(t, "BGTransparency="..tostring(g.BackgroundTransparency))
        table.insert(t, "BGColor="..tostring(g.BackgroundColor3))
    end
    if g:IsA("ImageLabel") or g:IsA("ImageButton") then
        table.insert(t, "Image="..tostring(g.Image))
        table.insert(t, "ImageId="..tostring(asset(g.Image)))
        table.insert(t, "ImageTransparency="..tostring(g.ImageTransparency))
        table.insert(t, "ImageColor="..tostring(g.ImageColor3))
    end
    return t
end

local function addPath(lines, base, names)
    local cur = base
    for _, n in ipairs(names) do cur = cur and cur:FindFirstChild(n) end
    table.insert(lines, "")
    table.insert(lines, "----- "..table.concat(names, ".").." -----")
    if cur then
        for _, x in ipairs(guiLine(cur)) do table.insert(lines, x) end
    else
        table.insert(lines, "NÃO EXISTE")
    end
end

local function addProgressScan(lines, base)
    addPath(lines, base, {"ProgressBar"})
    addPath(lines, base, {"ProgressBar","WarningImage"})
    addPath(lines, base, {"ProgressBar","TickImage"})
    addPath(lines, base, {"ProgressBar","BurntImage"})
    addPath(lines, base, {"ProgressBar","Progress"})
    addPath(lines, base, {"ProgressBar","Progress","Background"})
    addPath(lines, base, {"ProgressBar","Progress","Shadow"})
    addPath(lines, base, {"ProgressBar","Progress","Bar"})
end

local function scanPanela()
    local hob, source = findByAppliance("Hob", "hob")
    local lines = {}
    if not hob then
        table.insert(lines, "Nenhuma Hob detectada. Fique perto/de frente da panela.")
        printCopy("SCAN PANELA", lines)
        return
    end
    local pan = hob:FindFirstChild("FryingPan", true)
    table.insert(lines, "Fonte: "..tostring(source))
    table.insert(lines, "Hob="..path(hob))
    table.insert(lines, "Dist="..tostring(dist(hob) or "?"))
    table.insert(lines, "ApplianceType="..tostring(hob:GetAttribute("ApplianceType")))
    table.insert(lines, "UtensilType="..tostring(hob:GetAttribute("UtensilType")))
    table.insert(lines, "FryingPan="..(pan and path(pan) or "não encontrado"))
    table.insert(lines, "")
    table.insert(lines, "Children Hob:")
    for _, c in ipairs(hob:GetChildren()) do table.insert(lines, "  - "..c.Name.." ["..c.ClassName.."]") end
    if pan then
        table.insert(lines, "Children FryingPan:")
        for _, c in ipairs(pan:GetChildren()) do table.insert(lines, "  - "..c.Name.." ["..c.ClassName.."]") end
    end

    addProgressScan(lines, hob)
    if pan then
        addProgressScan(lines, pan)
        addPath(lines, pan, {"ItemPosition","IngredientsUi"})
        addPath(lines, pan, {"ItemPosition","IngredientsUi","Frame"})
        addPath(lines, pan, {"ItemPosition","IngredientsUi","Frame","PlusIcon","Icon"})
        addPath(lines, pan, {"ItemPosition","IngredientsUi","Frame","IngredientTemplate"})
        addPath(lines, pan, {"ItemPosition","IngredientsUi","Frame","IngredientTemplate","Icon"})
    end

    table.insert(lines, "")
    table.insert(lines, "Models importantes dentro da panela:")
    for _, d in ipairs((pan or hob):GetDescendants()) do
        if d:IsA("Model") then
            table.insert(lines, "  - "..d.Name.." | "..path(d))
        end
    end

    printCopy("SCAN PANELA", lines)
end

local function scanPia()
    local sink, source = findByAppliance("Sink", "sink")
    local lines = {}
    if not sink then
        table.insert(lines, "Nenhuma Sink detectada. Fique perto/de frente da pia.")
        printCopy("SCAN PIA", lines)
        return
    end

    table.insert(lines, "Fonte: "..tostring(source))
    table.insert(lines, "Sink="..path(sink))
    table.insert(lines, "Dist="..tostring(dist(sink) or "?"))
    table.insert(lines, "ApplianceType="..tostring(sink:GetAttribute("ApplianceType")))
    table.insert(lines, "")
    table.insert(lines, "Children Sink:")
    for _, c in ipairs(sink:GetChildren()) do table.insert(lines, "  - "..c.Name.." ["..c.ClassName.."]") end

    table.insert(lines, "")
    table.insert(lines, "ItemPosition:")
    local itemPos = sink:FindFirstChild("ItemPosition", true)
    if itemPos then
        table.insert(lines, "Path="..path(itemPos))
        table.insert(lines, "Children ItemPosition:")
        for _, c in ipairs(itemPos:GetChildren()) do table.insert(lines, "  - "..c.Name.." ["..c.ClassName.."]") end
    else
        table.insert(lines, "NÃO EXISTE")
    end

    addProgressScan(lines, sink)

    table.insert(lines, "")
    table.insert(lines, "Plate/DirtyPlate dentro da Sink:")
    local foundPlate = false
    for _, d in ipairs(sink:GetDescendants()) do
        local n = low(d.Name)
        if n:find("plate", 1, true) or n:find("dirty", 1, true) then
            foundPlate = true
            table.insert(lines, "  - "..d.Name.." ["..d.ClassName.."] | "..path(d))
        end
    end
    if not foundPlate then table.insert(lines, "  nenhum") end

    table.insert(lines, "")
    table.insert(lines, "GuiObjects importantes dentro da Sink:")
    for _, d in ipairs(sink:GetDescendants()) do
        if d:IsA("BillboardGui") or d:IsA("ImageLabel") or d:IsA("ImageButton") or d:IsA("Frame") then
            local n, pth = low(d.Name), low(path(d))
            if n:find("warning",1,true) or n:find("tick",1,true) or n:find("burnt",1,true)
            or n:find("progress",1,true) or n:find("bar",1,true)
            or pth:find("progressbar",1,true) then
                table.insert(lines, "")
                for _, x in ipairs(guiLine(d)) do table.insert(lines, x) end
            end
        end
    end

    table.insert(lines, "")
    table.insert(lines, "Plate/DirtyPlate no personagem:")
    local char = lp.Character
    local foundChar = false
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            local n = low(d.Name)
            if n:find("plate", 1, true) or n:find("dirty", 1, true) then
                foundChar = true
                table.insert(lines, "  - "..d.Name.." ["..d.ClassName.."] | "..path(d))
            end
        end
    end
    if not foundChar then table.insert(lines, "  nenhum") end

    printCopy("SCAN PIA", lines)
end

