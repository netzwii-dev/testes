-- 1. UTILS DE BUSCA (REGRA 18)
local function getNearest(name)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local closest, minD = nil, math.huge
    for _, obj in pairs(Interactables:GetChildren()) do
        if obj.Name == name or obj:FindFirstChild(name) then
            local dist = (root.Position - obj:GetPivot().Position).Magnitude
            if dist < minD then closest, minD = obj, dist end
        end
    end
    return closest
end

