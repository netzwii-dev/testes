--// CK Kebab Scanner v1
--// Scanner para a fase Cidade Symmetri / Kebab.
--// Só imprime no console. Não faz auto-farm.
--//
--// Rotas dessa fase:
--// carne -> panela/hob -> carne assada
--// abacaxi -> mesa de corte -> anéis de abacaxi
--// tomate -> mesa de corte -> tomate cortado

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local GUI_NAME = "CK_KebabScannerV1"
local RADIUS = 45
local MAX_SCAN = 12000

local GROUPS = {
    FoodBins = {"foodbin","ingredient","ingredients","tomato","tomate","pineapple","abacaxi","beef","meat","carne","kebab"},
    Appliances = {"chopping","chop","cut","knife","faca","board","hob","pan","saucepan","pot","grill","cook","cooking","countertop","counter"},
    Plates = {"plate","platespawner","dish","serveplate"},
    Delivery = {"delivery","deliver","serve","serving","customer","customers","order","orders","dropoff","window","cashier"}
}

local function low(x) return string.lower(tostring(x or "")) end

local function path(obj)
    local ok, res = pcall(function() return obj:GetFullName() end)
    return ok and res or tostring(obj)
end

local function asset(x)
    x = tostring(x or "")
    return x:match("rbxassetid://(%d+)") or x:match("id=(%d+)") or x
end

local function hrp()
    local c = lp.Character or lp.CharacterAdded:Wait()
    return c:FindFirstChild("HumanoidRootPart")
end

local function pos(obj)
    local p
    if obj:IsA("BasePart") then
        p = obj
    elseif obj:IsA("Model") then
        p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    else
        p = obj:FindFirstAncestorWhichIsA("BasePart")
    end
    return p and p.Position or nil
end

local function dist(obj)
    local h = hrp()
    local p = pos(obj)
    if not h or not p then return nil end
    return math.floor((p - h.Position).Magnitude)
end

local function posText(p)
    if not p then return "sem pos" end
    return math.floor(p.X)..","..math.floor(p.Y)..","..math.floor(p.Z)
end

local function root()
    return workspace:FindFirstChild("Interactables") or workspace
end

local function matchAny(text, words)
    text = low(text)
    for _, w in ipairs(words) do
        if text:find(low(w), 1, true) then return true, w end
    end
    return false, nil
end

local function classify(obj)
    local text = low(obj.Name.." "..path(obj))
    local out = {}
    for g, words in pairs(GROUPS) do
        local ok, w = matchAny(text, words)
        if ok then table.insert(out, g.."("..w..")") end
    end
    return table.concat(out, ", ")
end

local function topModel(obj)
    local r = root()
    local cur = obj
    while cur and cur.Parent and cur.Parent ~= r and cur.Parent ~= workspace do
        cur = cur.Parent
    end
    return cur or obj
end

local function attrs(obj)
    local out = {}
    for k, v in pairs(obj:GetAttributes()) do
        table.insert(out, tostring(k).."="..tostring(v))
    end
    table.sort(out)
    return out
end

local function important(obj, limit)
    local out = {}
    limit = limit or 32
    for _, d in ipairs(obj:GetDescendants()) do
        if #out >= limit then break end
        if d:IsA("ProximityPrompt") then
            table.insert(out, "PROMPT "..d.Name.." Action="..tostring(d.ActionText).." Object="..tostring(d.ObjectText).." | "..path(d))
        elseif d:IsA("Decal") or d:IsA("Texture") then
            table.insert(out, d.ClassName.." "..d.Name.." texture="..asset(d.Texture).." | "..path(d))
        elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
            table.insert(out, d.ClassName.." "..d.Name.." image="..asset(d.Image).." | "..path(d))
        elseif d:IsA("MeshPart") then
            local id = asset(d.TextureID)
            if id and id ~= "" then table.insert(out, "MeshPart "..d.Name.." textureID="..id.." | "..path(d)) end
        elseif d:IsA("SpecialMesh") then
            local id = asset(d.TextureId)
            if id and id ~= "" then table.insert(out, "SpecialMesh "..d.Name.." textureId="..id.." | "..path(d)) end
        elseif d:IsA("StringValue") or d:IsA("IntValue") or d:IsA("NumberValue") or d:IsA("BoolValue") or d:IsA("ObjectValue") then
            table.insert(out, "VALUE "..d.Name.." ["..d.ClassName.."] = "..tostring(d.Value).." | "..path(d))
        end
    end
    return out
end

local function children(obj)
    local out = {}
    for _, c in ipairs(obj:GetChildren()) do
        table.insert(out, "- "..c.Name.." ["..c.ClassName.."]")
        if #out >= 18 then break end
    end
    return out
end

local function printBlock(title, lines)
    warn("[CK SCAN] ===== "..title.." =====")
    local buf = {}
    for _, line in ipairs(lines) do
        table.insert(buf, line)
        if #buf >= 15 then
            print("[CK SCAN]\n"..table.concat(buf, "\n"))
            table.clear(buf)
            task.wait(0.05)
        end
    end
    if #buf > 0 then print("[CK SCAN]\n"..table.concat(buf, "\n")) end
    warn("[CK SCAN] ===== FIM "..title.." =====")
end

local function describe(obj, i)
    local lines = {}
    local d = dist(obj)
    local p = pos(obj)
    table.insert(lines, "---- OBJ #"..i.." ["..tostring(d or "?").." studs] ----")
    table.insert(lines, "Name: "..obj.Name.." ["..obj.ClassName.."]")
    table.insert(lines, "Class: "..(classify(obj) ~= "" and classify(obj) or "sem keyword"))
    table.insert(lines, "Path: "..path(obj))
    table.insert(lines, "Pos: "..posText(p))
    local a = attrs(obj)
    if #a > 0 then
        table.insert(lines, "Attributes:")
        for _, x in ipairs(a) do table.insert(lines, "  "..x) end
    end
    local ch = children(obj)
    if #ch > 0 then
        table.insert(lines, "Children:")
        for _, x in ipairs(ch) do table.insert(lines, "  "..x) end
    end
    local im = important(obj)
    if #im > 0 then
        table.insert(lines, "Assets/Prompts/Values:")
        for _, x in ipairs(im) do table.insert(lines, "  "..x) end
    end
    table.insert(lines, "")
    return lines
end

local function collect(words, radius)
    local found, used = {}, {}
    local n = 0
    for _, obj in ipairs(root():GetDescendants()) do
        n += 1
        if n > MAX_SCAN then break end
        local ok = matchAny(obj.Name.." "..path(obj), words)
        if ok then
            local target = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model") or obj
            target = topModel(target)
            local d = dist(target)
            if (not radius) or (d and d <= radius) then
                local p = path(target)
                if not used[p] then
                    used[p] = true
                    table.insert(found, target)
                end
            end
        end
    end
    table.sort(found, function(a,b)
        local da, db = dist(a) or 99999, dist(b) or 99999
        if da == db then return path(a) < path(b) end
        return da < db
    end)
    return found
end

local function collectNearby()
    local all = {}
    for _, words in pairs(GROUPS) do
        for _, obj in ipairs(collect(words, RADIUS)) do
            all[path(obj)] = obj
        end
    end
    local list = {}
    for _, obj in pairs(all) do table.insert(list, obj) end
    table.sort(list, function(a,b)
        local da, db = dist(a) or 99999, dist(b) or 99999
        if da == db then return path(a) < path(b) end
        return da < db
    end)
    return list
end

local function scan(title, list)
    local lines = {
        "Player: "..lp.Name,
        "Root: "..path(root()),
        "Encontrados: "..#list,
        ""
    }
    for i, obj in ipairs(list) do
        for _, line in ipairs(describe(obj, i)) do table.insert(lines, line) end
    end
    printBlock(title, lines)
end

local function scanPedido()
    local lines = {}
    local recipes = pg:FindFirstChild("Root") and pg.Root:FindFirstChild("HUD") and pg.Root.HUD:FindFirstChild("Recipes")
    table.insert(lines, "Recipes path: "..(recipes and path(recipes) or "não achei Root.HUD.Recipes"))
    table.insert(lines, "")
    if recipes then
        local i = 0
        for _, d in ipairs(recipes:GetDescendants()) do
            if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Visible then
                local id = asset(d.Image)
                if id and id ~= "" and id ~= "rbxasset://textures/ui/GuiImagePlaceholder.png" then
                    i += 1
                    table.insert(lines, i..") IMAGE "..d.Name.." id="..id)
                    table.insert(lines, "   size="..math.floor(d.AbsoluteSize.X).."x"..math.floor(d.AbsoluteSize.Y).." pos="..math.floor(d.AbsolutePosition.X)..","..math.floor(d.AbsolutePosition.Y))
                    table.insert(lines, "   path="..path(d))
                end
            elseif (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible and tostring(d.Text) ~= "" then
                i += 1
                table.insert(lines, i..") TEXT "..d.Name.." = "..tostring(d.Text))
                table.insert(lines, "   path="..path(d))
            end
        end
    end
    printBlock("PEDIDO", lines)
end

