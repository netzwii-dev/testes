--// Caos na Cozinha - Scan Frente v1
--// Só tem 1 botão: SCAN FRENTE
--// Ele tenta detectar o objeto que está na sua frente / perto da marcação de interação do jogo.
--// Não faz auto-farm, não interage, só imprime no console.
--//
--// Como usar:
--// 1) fica de frente para a coisa que quer identificar
--// 2) chega perto o suficiente para aparecer a marcação/interação vermelha do jogo
--// 3) aperta SCAN FRENTE
--// 4) manda o console

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")
local cam = Workspace.CurrentCamera

local GUI_NAME = "CK_ScanFrenteV1"

local RAY_DISTANCE = 70
local PROMPT_RADIUS = 18
local SCREEN_CENTER_WEIGHT = 1.35

local IMPORTANT_WORDS = {
    "foodbin","ingredient","ingredients",
    "tomato","tomate",
    "pineapple","abacaxi",
    "beef","meat","carne",
    "kebab",

    "chopping","chop","cut","knife","faca","board",
    "hob","pan","saucepan","pot","grill","cook","cooking",
    "countertop","counter",

    "plate","platespawner","dish","serveplate",

    "delivery","deliver","serve","serving","customer","customers",
    "order","orders","dropoff","window","cashier"
}

local function low(x)
    return string.lower(tostring(x or ""))
end

local function path(obj)
    local ok, res = pcall(function()
        return obj:GetFullName()
    end)
    return ok and res or tostring(obj)
end

local function asset(x)
    x = tostring(x or "")
    return x:match("rbxassetid://(%d+)") or x:match("id=(%d+)") or x
end

local function getChar()
    return lp.Character or lp.CharacterAdded:Wait()
end

local function getHRP()
    local c = getChar()
    return c:FindFirstChild("HumanoidRootPart")
end

local function objPart(obj)
    if not obj then return nil end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end

    return obj:FindFirstAncestorWhichIsA("BasePart")
end

local function objPos(obj)
    local p = objPart(obj)
    return p and p.Position or nil
end

local function dist(obj)
    local h = getHRP()
    local p = objPos(obj)

    if not h or not p then
        return nil
    end

    return math.floor((p - h.Position).Magnitude)
end

local function posText(p)
    if not p then return "sem pos" end
    return math.floor(p.X)..","..math.floor(p.Y)..","..math.floor(p.Z)
end

local function root()
    return workspace:FindFirstChild("Interactables") or workspace
end

local function hasImportantWord(obj)
    local text = low(obj.Name .. " " .. path(obj))

    for _, w in ipairs(IMPORTANT_WORDS) do
        if text:find(low(w), 1, true) then
            return true, w
        end
    end

    return false, nil
end

local function topInteractable(obj)
    if not obj then return nil end

    local r = root()
    local cur = obj

    if not cur:IsA("Model") then
        cur = cur:FindFirstAncestorOfClass("Model") or cur
    end

    while cur and cur.Parent and cur.Parent ~= r and cur.Parent ~= workspace do
        local parent = cur.Parent

        -- se o objeto atual já parece importante, para nele
        local ok = hasImportantWord(cur)
        if ok then
            break
        end

        cur = parent
    end

    return cur
end

local function attrs(obj)
    local out = {}

    for k, v in pairs(obj:GetAttributes()) do
        table.insert(out, tostring(k).."="..tostring(v))
    end

    table.sort(out)
    return out
end

local function children(obj)
    local out = {}

    for _, c in ipairs(obj:GetChildren()) do
        table.insert(out, "- "..c.Name.." ["..c.ClassName.."]")
        if #out >= 25 then
            break
        end
    end

    return out
end

local function importantDesc(obj, limit)
    local out = {}
    limit = limit or 55

    for _, d in ipairs(obj:GetDescendants()) do
        if #out >= limit then
            break
        end

        if d:IsA("ProximityPrompt") then
            table.insert(out, "PROMPT "..d.Name.." ActionText="..tostring(d.ActionText).." ObjectText="..tostring(d.ObjectText).." Hold="..tostring(d.HoldDuration).." | "..path(d))

        elseif d:IsA("Decal") or d:IsA("Texture") then
            local id = asset(d.Texture)
            if id and id ~= "" then
                table.insert(out, d.ClassName.." "..d.Name.." texture="..id.." | "..path(d))
            end

        elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
            local id = asset(d.Image)
            if id and id ~= "" then
                table.insert(out, d.ClassName.." "..d.Name.." image="..id.." | "..path(d))
            end

        elseif d:IsA("MeshPart") then
            local id = asset(d.TextureID)
            if id and id ~= "" then
                table.insert(out, "MeshPart "..d.Name.." textureID="..id.." | "..path(d))
            end

        elseif d:IsA("SpecialMesh") then
            local id = asset(d.TextureId)
            if id and id ~= "" then
                table.insert(out, "SpecialMesh "..d.Name.." textureId="..id.." | "..path(d))
            end

        elseif d:IsA("StringValue") or d:IsA("IntValue") or d:IsA("NumberValue") or d:IsA("BoolValue") or d:IsA("ObjectValue") then
            table.insert(out, "VALUE "..d.Name.." ["..d.ClassName.."] = "..tostring(d.Value).." | "..path(d))
        end
    end

    return out
end

local function screenScore(obj)
    local p = objPos(obj)
    if not p or not cam then return math.huge end

    local v, onScreen = cam:WorldToViewportPoint(p)
    if not onScreen then
        return math.huge
    end

    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local point = Vector2.new(v.X, v.Y)

    return (point - center).Magnitude
end

local function nearestPromptTarget()
    local h = getHRP()
    if not h then return nil end

    local bestObj = nil
    local bestScore = math.huge

    for _, d in ipairs(root():GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local part = d.Parent
            local p = objPos(part)

            if p then
                local distance = (p - h.Position).Magnitude

                if distance <= PROMPT_RADIUS then
                    local target = topInteractable(part)
                    local s = distance + (screenScore(target or part) / 120) * SCREEN_CENTER_WEIGHT

                    if s < bestScore then
                        bestScore = s
                        bestObj = target or part
                    end
                end
            end
        end
    end

    return bestObj
end

local function rayTarget()
    if not cam then return nil end

    local centerX = cam.ViewportSize.X / 2
    local centerY = cam.ViewportSize.Y / 2

    local ray = cam:ViewportPointToRay(centerX, centerY)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.IgnoreWater = true

    local ignore = {}
    local char = lp.Character
    if char then table.insert(ignore, char) end
    params.FilterDescendantsInstances = ignore

    local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_DISTANCE, params)

    if result and result.Instance then
        return topInteractable(result.Instance) or result.Instance, result.Instance, result.Position
    end

    return nil
end

local function frontalImportantTarget()
    local h = getHRP()
    if not h or not cam then return nil end

    local best = nil
    local bestScore = math.huge

    for _, obj in ipairs(root():GetDescendants()) do
        local ok = hasImportantWord(obj)
        if ok then
            local target = topInteractable(obj)
            local p = objPos(target)

            if p then
                local offset = p - h.Position
                local distance = offset.Magnitude

                if distance <= RAY_DISTANCE then
                    local dir = cam.CFrame.LookVector
                    local dot = dir:Dot(offset.Unit)

                    -- só coisas na frente da câmera/personagem
                    if dot > 0.45 then
                        local s = screenScore(target) + distance * 2

                        if s < bestScore then
                            bestScore = s
                            best = target
                        end
                    end
                end
            end
        end
    end

    return best
end

local function printBlock(title, lines)
    warn("[CK FRENTE] ===== "..title.." =====")

    local buf = {}

    for _, line in ipairs(lines) do
        table.insert(buf, line)

        if #buf >= 16 then
            print("[CK FRENTE]\n"..table.concat(buf, "\n"))
            table.clear(buf)
            task.wait(0.05)
        end
    end

    if #buf > 0 then
        print("[CK FRENTE]\n"..table.concat(buf, "\n"))
    end

    warn("[CK FRENTE] ===== FIM "..title.." =====")
end

local function describe(obj, source, hitPart, hitPos)
    local lines = {}

    if not obj then
        table.insert(lines, "Nada detectado.")
        table.insert(lines, "Dica: chegue mais perto, deixe a marcação vermelha aparecer, olhe para o objeto e aperte de novo.")
        printBlock("SCAN FRENTE", lines)
        return
    end

    local p = objPos(obj)
    local d = dist(obj)
    local ok, word = hasImportantWord(obj)

    table.insert(lines, "Fonte da detecção: "..tostring(source))
    table.insert(lines, "Player: "..lp.Name)
    table.insert(lines, "Root: "..path(root()))
    table.insert(lines, "")
    table.insert(lines, "TARGET")
    table.insert(lines, "Name: "..obj.Name.." ["..obj.ClassName.."]")
    table.insert(lines, "Path: "..path(obj))
    table.insert(lines, "Pos: "..posText(p))
    table.insert(lines, "Distância: "..tostring(d or "?").." studs")
    table.insert(lines, "Keyword: "..tostring(word or "nenhuma"))
    table.insert(lines, "ScreenScore: "..tostring(math.floor(screenScore(obj))))
    table.insert(lines, "")

    if hitPart then
        table.insert(lines, "HitPart/Raycast")
        table.insert(lines, "HitPart: "..hitPart.Name.." ["..hitPart.ClassName.."]")
        table.insert(lines, "HitPartPath: "..path(hitPart))
        table.insert(lines, "HitPos: "..posText(hitPos))
        table.insert(lines, "")
    end

    local a = attrs(obj)
    if #a > 0 then
        table.insert(lines, "Attributes:")
        for _, x in ipairs(a) do
            table.insert(lines, "  "..x)
        end
        table.insert(lines, "")
    end

    local ch = children(obj)
    if #ch > 0 then
        table.insert(lines, "Children:")
        for _, x in ipairs(ch) do
            table.insert(lines, "  "..x)
        end
        table.insert(lines, "")
    end

    local im = importantDesc(obj, 70)
    if #im > 0 then
        table.insert(lines, "Assets/Prompts/Values:")
        for _, x in ipairs(im) do
            table.insert(lines, "  "..x)
        end
        table.insert(lines, "")
    end

    printBlock("SCAN FRENTE", lines)
end

local function scanFrente()
    -- prioridade 1: ProximityPrompt perto da marcação/interação
    local ptarget = nearestPromptTarget()
    if ptarget then
        describe(ptarget, "ProximityPrompt mais próximo/central")
        return
    end

    -- prioridade 2: raycast no centro da câmera
    local rtarget, hitPart, hitPos = rayTarget()
    if rtarget then
        describe(rtarget, "Raycast centro da câmera", hitPart, hitPos)
        return
    end

    -- prioridade 3: objeto importante mais central na frente
    local ftarget = frontalImportantTarget()
    if ftarget then
        describe(ftarget, "Objeto importante na frente")
        return
    end

    describe(nil, "nenhuma")
end

